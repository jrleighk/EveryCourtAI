        "gut_poly",
        "multi_poly"
      ]
    }
  },

  "gauge_relationship_rules": {
    "default": {
      "main_cross_difference_mm": "0.00-0.05"
    },

    "shaped_main_round_cross": {
      "preferred": [
        "1.23 / 1.25",
        "1.20 / 1.25",
        "1.25 / 1.25"
      ]
    },

    "poly_main_multi_cross": {
      "preferred": [
        "1.25 / 1.30",
        "1.20 / 1.30",
        "1.25 / 1.25"
      ]
    },

    "gut_main_poly_cross": {
      "preferred": [
        "1.30 / 1.25",
        "1.25 / 1.25"
      ]
    },

    "multi_main_poly_cross": {
      "preferred": [
        "1.30 / 1.25",
        "1.25 / 1.20"
      ]
    }
  },

  "hybrid_candidate_scoring": {
    "base_score": 50,

    "positive_match": {
      "strong": 12,
      "medium": 7,
      "weak": 3
    },

    "negative_match": {
      "strong": -15,
      "medium": -8,
      "weak": -3
    },

    "hard_constraint_failure": {
      "action": "exclude_architecture"
    },

    "ranking_weights": {
      "physical_compatibility": 0.22,
      "goal_conflict_resolution": 0.20,
      "racquet_compensation": 0.16,
      "swing_speed_match": 0.12,
      "playing_style_match": 0.10,
      "comfort": 0.07,
      "spin_or_control_target": 0.06,
      "durability": 0.04,
      "feel": 0.03
    }
  },

  "full_bed_vs_hybrid_output": {
    "decision_options": [
      "full_bed_preferred",
      "hybrid_preferred",
      "both_viable"
    ],

    "output_fields": [
      "decision",
      "hybrid_score",
      "full_bed_score",
      "recommended_architecture",
      "main_role",
      "cross_role",
      "recommended_main_candidates",
      "recommended_cross_candidates",
      "recommended_gauge_relationship",
      "confidence",
      "primary_reasons",
      "tradeoffs",
      "risk_flags"
    ]
  },

  "explanation_rules": {
    "must_explain": [
      "Why a hybrid is preferred over a suitable full bed.",
      "What role the main string performs.",
      "What role the cross string performs.",
      "What performance conflict the hybrid solves.",
      "What the main tradeoff is."
    ],

    "must_not_do": [
      "Do not recommend a hybrid merely because it is more advanced.",
      "Do not call a full-bed setup a hybrid.",
      "Do not assume hybrids are automatically more comfortable.",
      "Do not use a firm polyester cross when physical constraints clearly prohibit it.",
      "Do not select two strings with redundant roles unless there is a specific reason."
    ]
  },

