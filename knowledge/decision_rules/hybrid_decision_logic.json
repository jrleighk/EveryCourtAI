  },

  "main_cross_role_logic": {
    "main_string_priority": {
      "influence": "High",
      "dominant_attributes": [
        "Overall Feel",
        "Spin Behavior",
        "Power Character",
        "Ball Interaction"
      ]
    },

    "cross_string_priority": {
      "influence": "Medium-High",
      "dominant_attributes": [
        "Snapback",
        "Comfort Tuning",
        "Launch Control",
        "Stringbed Stability",
        "Response Speed"
      ]
    }
  },

  "goal_based_hybrid_logic": {
    "more_control_plus_more_comfort": {
      "preferred_architectures": [
        "poly_multi",
        "firm_poly_soft_poly",
        "gut_poly"
      ]
    },

    "more_spin_plus_more_comfort": {
      "preferred_architectures": [
        "soft_poly_elastic_cross",
        "shaped_poly_round_poly",
        "poly_multi"
      ]
    },

    "more_feel_plus_more_control": {
      "preferred_architectures": [
        "gut_poly",
        "multi_poly"
      ]
    },

    "more_spin_plus_lower_launch": {
      "preferred_architectures": [
        "shaped_poly_round_poly"
      ]
    },

    "more_power_plus_more_control": {
      "preferred_architectures": [
        "gut_poly",
        "multi_poly"
      ]
    }
  },

  "racquet_compensation_rules": {
    "high_power_high_stiffness_racquet": {
      "preferred_architectures": [
        "poly_multi",
        "soft_poly_elastic_cross",
        "shaped_poly_round_poly"
      ],

      "deprioritize": [
        "Very Powerful Multi Main + Powerful Cross",
        "Firm Poly + Firm Poly At High Tension"
      ]
    },

    "low_power_control_racquet": {
      "preferred_architectures": [
        "gut_poly",
        "multi_poly",
        "soft_poly_elastic_cross"
      ]
    },

    "spin_oriented_open_pattern_racquet": {
      "preferred_architectures": [
        "shaped_poly_round_poly",
        "poly_multi"
      ],

      "prioritize": [
        "Controlled Launch",
        "Durability",
        "Tension Stability"
      ]
    },

    "small_head_dense_pattern_racquet": {
      "preferred_architectures": [
        "gut_poly",
        "multi_poly",
        "soft_poly_elastic_cross"
      ],

      "prioritize": [
        "Elasticity",
        "Pocketing",
        "Thin Or Medium Gauge"
      ]
    }
  },

  "physical_constraint_rules": {
    "none": {
      "allowed_architectures": "all"
    },

    "mild_arm_sensitivity": {
      "preferred_architectures": [
        "poly_multi",
        "soft_poly_elastic_cross",
        "gut_poly"
      ],

      "penalize": [
        "firm_poly_soft_poly",
        "Very Firm Poly/Poly"
      ]
    },

    "moderate_arm_sensitivity": {
      "preferred_architectures": [
        "gut_poly",
        "multi_poly",
        "soft_poly_elastic_cross"
      ],

      "strongly_penalize": [
        "shaped_poly_round_poly",
        "firm_poly_soft_poly"
      ]
    },

    "high_arm_sensitivity": {
      "preferred_architectures": [
        "gut_poly",
        "multi_poly"
      ],

      "avoid": [
        "Firm Poly/Poly",
        "Shaped Poly/Poly",
        "High-Tension Polyester Hybrids"
      ]
    }
  },

  "swing_speed_rules": {
    "slow": {
      "preferred_architectures": [
        "multi_poly",
        "gut_poly",
        "soft_poly_elastic_cross"
      ],

      "deprioritize": [
        "firm_poly_soft_poly",
        "shaped_poly_round_poly"
      ]
    },

    "medium": {
      "preferred_architectures": [
        "poly_multi",
        "gut_poly",
        "soft_poly_elastic_cross",
        "multi_poly"
      ]
    },

    "fast": {
      "preferred_architectures": [
        "shaped_poly_round_poly",
        "poly_multi",
        "firm_poly_soft_poly",
        "gut_poly"
      ]
    }
  },

