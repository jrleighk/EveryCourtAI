        "zh": "多芯主线 / 聚酯横线"
      },

      "primary_identity": "Comfort + Feel + More Control",

      "main_role": [
        "Comfort",
        "Power",
        "Pocketing",
        "Feel"
      ],

      "cross_role": [
        "Control",
        "Launch Management",
