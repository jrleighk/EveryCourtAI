{
  "id": "hybrid_decision_logic",
  "category": "Decision Rules",
  "type": "Hybrid Selection Engine",
  "version": "1.0",
  "last_updated": "2026-08-15",

  "description": {
    "en": "Core decision logic used by EveryCourtAI to determine whether a player should use a full-bed setup or a hybrid string configuration, and which hybrid architecture best fits the player's needs.",
    "zh": "EveryCourtAI 用于判断球员应使用整床穿线还是混线，并进一步选择最合适混线结构的核心决策逻辑。"
  },

  "decision_pipeline": [
    "Read Player Profile",
    "Read Current Racquet DNA",
    "Read Current String Setup",
    "Read Current Setup Feedback",
    "Apply Physical Constraints",
    "Determine Whether Full Bed Can Satisfy Primary Goal",
    "Check Goal Conflicts",
    "Check Racquet And Stringbed Compatibility",
    "Check Durability Requirements",
    "Check Comfort Requirements",
    "Determine Hybrid Architecture",
    "Select Main String Role",
    "Select Cross String Role",
    "Select Candidate Strings",
    "Recommend Gauge Relationship",
    "Pass Configuration To Tension Engine"
  ],

  "core_principle": {
    "en": "Use a hybrid only when combining two different string roles creates a meaningful performance advantage over a suitable full-bed setup.",
    "zh": "只有当两种球线承担不同功能并能明显优于合适的整床方案时，才推荐 Hybrid，而不是为了复杂而混线。"
  },

  "default_behavior": {
    "prefer_full_bed_when": [
      "A single string can satisfy the player's primary goal without violating comfort or durability constraints.",
      "The player values simplicity and consistency.",
      "The player is still developing clear equipment preferences.",
      "The player has not provided enough information to justify a hybrid."
    ],

    "consider_hybrid_when": [
      "The player has two important but conflicting performance goals.",
      "Full polyester provides enough control but insufficient comfort.",
      "Multifilament or natural gut provides enough comfort but insufficient control.",
      "The player wants shaped-string bite plus smoother snapback.",
      "The player wants premium feel with polyester-style control.",
      "The racquet is powerful or stiff and needs the stringbed to balance multiple characteristics."
    ]
  },

  "hybrid_trigger_scores": {
    "minimum_score_to_consider_hybrid": 65,
    "minimum_score_to_prefer_hybrid": 80,

    "trigger_weights": {
      "goal_conflict": 0.25,
      "comfort_need": 0.20,
      "racquet_compensation_need": 0.15,
      "spin_snapback_need": 0.15,
      "feel_control_balance": 0.10,
      "durability_need": 0.05,
      "player_experience": 0.05,
      "current_setup_failure": 0.05
    }
  },

  "full_bed_preference_rules": {
    "full_polyester": {
      "prefer_when": [
        "Player has medium or fast swing speed.",
        "Player wants control, spin and durability.",
        "Arm sensitivity is none or mild.",
        "A single polyester can satisfy the player's comfort requirements."
      ],

      "avoid_when": [
        "Moderate or high arm sensitivity.",
        "Current full polyester is already reported as too stiff.",
        "Player wants significantly more comfort or pocketing."
      ]
    },

    "full_multifilament": {
      "prefer_when": [
        "Comfort is the dominant goal.",
        "Swing speed is slow or medium.",
        "Player does not frequently break strings.",
        "Maximum spin is not required."
      ],

      "avoid_when": [
        "Fast swing speed with frequent over-hitting.",
        "Heavy topspin player requiring high snapback.",
        "Frequent string breaker."
      ]
    },

    "full_natural_gut": {
      "prefer_when": [
        "Maximum feel, comfort and tension maintenance are priorities.",
        "Budget is not a major constraint.",
        "Player wants premium response without polyester stiffness."
      ]
    },

    "full_synthetic_gut": {
      "prefer_when": [
        "Player wants a simple and affordable setup.",
        "Player is beginner or recreational.",
        "Comfort and easy power are more important than advanced spin performance."
      ]
    }
  },

  "hybrid_architectures": {
    "gut_poly": {
      "id": "gut_poly",
      "name": {
        "en": "Natural Gut Main / Polyester Cross",
        "zh": "天然肠主线 / 聚酯横线"
      },

      "primary_identity": "Premium Feel + Comfort + Controlled Spin",

      "main_role": [
        "Power",
        "Feel",
        "Comfort",
        "Ball Pocketing",
        "Tension Maintenance"
      ],

      "cross_role": [
        "Control",
        "Snapback",
        "Launch Management",
        "Spin Support",
        "Stringbed Stabilization"
      ],

      "prefer_when": [
        "Player wants maximum feel and comfort without giving up control.",
        "Player is all-court or serve-volley oriented.",
        "Player values tension maintenance and premium response.",
        "Player uses a control-oriented racquet and wants more usable power."
      ],

      "avoid_when": [
        "Frequent natural-gut breaker.",
        "Budget is a major constraint.",
        "Player regularly plays in wet conditions without string protection."
      ],

      "main_string_types": [
        "Natural Gut"
      ],

      "cross_string_types": [
        "Round Co-Polyester",
        "Smooth Co-Polyester",
        "Lightly Textured Co-Polyester"
      ],

      "gauge_guidance": {
        "main_mm": [
          1.25,
          1.30
        ],
        "cross_mm": [
          1.20,
          1.25
        ]
      }
    },

