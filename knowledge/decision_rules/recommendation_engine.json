      "racquet_change": null
    },

    "risk_flags": [],

    "next_test": {
      "recommended_test_duration_hours": null,
      "feedback_questions": [
        "Was depth easier or harder to control?",
        "Did launch angle feel higher or lower?",
        "Was the stringbed more or less comfortable?",
        "Did spin improve?",
        "Did control improve?",
        "Did performance change after several hours?"
      ]
    }
  },

  "feedback_loop": {
    "enabled": true,

    "purpose": {
      "en": "Use real player feedback to refine future recommendations.",
      "zh": "利用真实球员反馈逐步修正后续推荐。"
    },

    "feedback_fields": [
      "hours_played",
      "power_feedback",
      "control_feedback",
      "spin_feedback",
      "comfort_feedback",
      "feel_feedback",
      "launch_feedback",
      "durability_feedback",
      "tension_maintenance_feedback",
      "overall_rating"
    ],

    "future_learning_ready": true
  },

  "safety_and_integrity_rules": {
    "do_not": [
      "Do not invent racquet specifications.",
      "Do not invent string specifications.",
      "Do not claim medical treatment benefits.",
      "Do not prioritize professional-player usage over player fit.",
      "Do not recommend an expensive racquet when a small string adjustment is likely sufficient.",
      "Do not present a low-confidence recommendation as precise fact.",
      "Do not rank special editions higher solely for rarity or cosmetic value."
    ],

    "must": [
      "Use verified database information where available.",
      "Separate verified product facts from EveryCourtAI model inference.",
      "Expose meaningful tradeoffs.",
      "Lower confidence when source data is incomplete.",
      "Respect physical constraints before performance goals."
    ]
  },

  "engine_connections": {
    "reads_from": [
      "knowledge/decision_rules/goal_priority.json",
      "knowledge/decision_rules/string_selection_logic.json",
      "knowledge/decision_rules/hybrid_decision_logic.json",
      "knowledge/decision_rules/tension_adjustment_logic.json",
      "knowledge/decision_rules/racquet_selection_logic.json",
      "knowledge/recommendations/full_bed_strings.json",
      "knowledge/recommendations/hybrid_strings.json",
      "knowledge/recommendations/tension_rules.json",
      "knowledge/players/player_profile_schema.json",
      "knowledge/racquets/",
      "knowledge/strings/"
    ],

    "final_engine": true
  }
}
