{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EveryCourtAI String Schema",
  "type": "object",

  "properties": {

    "id": {
      "type": "string"
    },

    "brand": {
      "type": "string"
    },

    "model": {
      "type": "string"
    },

    "type": {
      "type": "string",
      "description": "polyester, multifilament, natural gut, hybrid"
    },

    "gauge": {
      "type": "string",
      "description": "string thickness"
    },

    "material": {
      "type": "string"
    },

    "power_level": {
      "type": "number"
    },

    "control_level": {
      "type": "number"
    },

    "spin_potential": {
      "type": "number"
    },

    "comfort_level": {
      "type": "number"
    },

    "durability": {
      "type": "number"
    },

    "recommended_players": {
      "type": "array"
    },

    "recommended_rackets": {
      "type": "array"
    },

    "recommended_tension_range": {
      "type": "object"
    },

    "ai_notes": {
      "type": "string"
    }

  },

  "required": [
    "id",
    "brand",
    "model",
    "type"
  ]
}
