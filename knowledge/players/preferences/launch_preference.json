{
  "id": "launch_preference",
  "category": "Player Preference",
  "version": "1.0",
  "last_updated": "2026-08-15",

  "preference": {
    "name": {
      "en": "Launch Angle Preference",
      "zh": "出球弹道偏好"
    },
    "description": {
      "en": "Defines the player's preferred ball-launch window and trajectory behavior. This is a subjective preference and should be interpreted together with playing style, spin level, racquet DNA and performance goals.",
      "zh": "定义球员偏好的出球窗口与弹道特征。该项目属于主观偏好，需要结合打法、旋转水平、球拍 DNA 与性能目标共同判断。"
    }
  },

  "priority": {
    "type": "Preference",
    "override_level": "Low-Medium",
    "can_override": [
      "brand_preference",
      "cosmetic_preference"
    ],
    "cannot_override": [
      "physical_constraints",
      "manufacturer_limits",
      "major_current_setup_problems"
    ]
  },

  "allowed_preferences": {
    "low": {
      "name": {
        "en": "Low Launch",
        "zh": "低弹道"
      },
      "description": {
        "en": "A flatter and more penetrating trajectory with lower net clearance and a more direct ball flight.",
        "zh": "更平、更穿透的弹道，过网高度较低，出球方向更直接。"
      }
    },

    "medium_low": {
      "name": {
        "en": "Medium-Low Launch",
        "zh": "中低弹道"
      },
      "description": {
        "en": "A controlled and penetrating launch with slightly more margin than a true low-launch setup.",
        "zh": "保持较强穿透性的同时，比纯低弹道拥有更多安全余量。"
      }
    },

    "medium": {
      "name": {
        "en": "Medium Launch",
        "zh": "中等弹道"
      },
      "description": {
        "en": "A neutral trajectory balancing control, net clearance, spin potential and directional predictability.",
        "zh": "在控制、过网高度、旋转和方向稳定性之间取得平衡的中性弹道。"
      }
    },

    "medium_high": {
      "name": {
        "en": "Medium-High Launch",
        "zh": "中高弹道"
      },
      "description": {
        "en": "A higher launch window that supports topspin, net clearance and safer aggressive baseline play.",
        "zh": "更高的出球窗口，有利于上旋、过网安全以及底线积极进攻。"
      }
    },

    "high": {
      "name": {
        "en": "High Launch",
        "zh": "高弹道"
      },
      "description": {
        "en": "A high-arching trajectory designed to maximize net clearance, topspin shape and heavy vertical ball movement.",
        "zh": "强调高过网、高上旋以及明显纵向轨迹变化的高弹道。"
      }
    }
  },

