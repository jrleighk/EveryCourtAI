  "preference": {
    "name": {
      "en": "String Break Frequency",
      "zh": "断线频率"
    },
    "description": {
      "en": "Represents how frequently the player breaks strings during normal play. This helps EveryCourtAI balance durability, playability, comfort and cost.",
      "zh": "表示球员在正常打球过程中断线的频率，用于帮助 EveryCourtAI 在耐久、手感、舒适性与成本之间取得平衡。"
    }
  },

  "priority": {
    "type": "Preference",
    "override_level": "Medium",
    "can_override": [
      "brand_preference",
      "cosmetic_preference"
    ],
    "cannot_override": [
      "physical_constraints",
      "manufacturer_limits",
      "current_setup_failures"
    ]
  },

  "frequency_levels": {
    "very_frequent": {
      "name": {
        "en": "Very Frequent",
        "zh": "经常断线"
      },
      "description": {
        "en": "Usually breaks strings within 5 hours.",
        "zh": "通常 5 小时以内断线。"
      },
      "estimated_hours": {
        "max": 5
      }
    },

    "frequent": {
      "name": {
        "en": "Frequent",
        "zh": "较常断线"
      },
      "description": {
        "en": "Usually breaks strings within 5–10 hours.",
        "zh": "通常 5–10 小时断线。"
      },
      "estimated_hours": {
        "min": 5,
        "max": 10
      }
    },

    "normal": {
      "name": {
        "en": "Normal",
        "zh": "一般"
      },
      "description": {
        "en": "Strings normally last 10–20 hours.",
        "zh": "通常可使用 10–20 小时。"
      },
      "estimated_hours": {
        "min": 10,
        "max": 20
      }
    },

    "rare": {
      "name": {
        "en": "Rarely Breaks Strings",
        "zh": "很少断线"
      },
      "description": {
        "en": "Strings generally last more than 20 hours.",
        "zh": "通常超过 20 小时以上才会断线。"
      },
      "estimated_hours": {
        "min": 20
      }
    },

    "never": {
      "name": {
        "en": "Almost Never",
        "zh": "几乎不断线"
      },
      "description": {
        "en": "Player normally cuts strings before they break.",
        "zh": "通常还没断线就主动剪线。"
      }
    }
  },

