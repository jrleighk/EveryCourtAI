{
  "id": "feel_preference",
  "category": "Player Preference",
  "version": "1.0",
  "last_updated": "2026-08-15",

  "preference": {
    "name": {
      "en": "Feel Preference",
      "zh": "击球手感偏好"
    },
    "description": {
      "en": "Defines the player's preferred impact sensation and stringbed response. This is a preference, not a performance goal or physical constraint.",
      "zh": "定义球员长期偏好的击球触感与线床响应。它属于个人偏好，而不是性能目标或身体限制条件。"
    }
  },

  "priority": {
    "type": "Preference",
    "override_level": "Low-Medium",
    "can_override": [
      "brand_preference",
      "cosmetic_preference"
    ],
    "cannot_override": [
      "physical_constraints",
      "manufacturer_limits",
      "major_current_setup_problems"
    ]
  },

  "allowed_preferences": {
    "plush": {
      "name": {
        "en": "Plush",
        "zh": "柔韧包裹型"
      },
      "description": {
        "en": "Deep, cushioned and pocketing-oriented response with reduced harshness.",
        "zh": "强调深度包球、柔和缓冲与低冲击感的线床反馈。"
      }
    },

    "soft": {
      "name": {
        "en": "Soft",
        "zh": "柔软型"
      },
      "description": {
        "en": "Low-stiffness and comfortable response with easier deformation at impact.",
        "zh": "强调较低刚性、舒适性与击球时更容易形变的反馈。"
      }
    },

    "connected": {
      "name": {
        "en": "Connected",
        "zh": "连接感型"
      },
      "description": {
        "en": "Clear communication between ball, stringbed and racquet without excessive harshness or muting.",
        "zh": "强调球、线床与球拍之间清晰直接的连接感，同时避免过度生硬或过度闷感。"
      }
    },

    "crisp": {
      "name": {
        "en": "Crisp",
        "zh": "清脆型"
      },
      "description": {
        "en": "Fast, clean and defined impact response with immediate feedback.",
        "zh": "强调快速、清晰、干净的触球反馈与较明显的瞬间响应。"
      }
    },

    "firm": {
      "name": {
        "en": "Firm",
        "zh": "硬朗型"
      },
      "description": {
        "en": "Stable, controlled and low-deformation response with minimal trampoline sensation.",
        "zh": "强调稳定、控制和较低形变，减少明显的弹床感。"
      }
    },

    "muted": {
      "name": {
        "en": "Muted",
        "zh": "低震闷感型"
      },
      "description": {
        "en": "Filtered, damped response with reduced vibration and less sharp impact information.",
        "zh": "强调过滤震动、降低锐利反馈和更安静柔和的触球感。"
      }
    }
  },

