  "output_guidance": {
    "must_explain": [
      "How the recommended setup matches the player's preferred impact feel.",
      "Whether the feel comes mainly from the racquet, string or tension.",
      "What performance tradeoff the selected feel introduces.",
      "Whether physical constraints limit the requested feel."
    ],

    "must_not_do": [
      "Do not confuse soft feel with high comfort in every case.",
      "Do not treat crisp as automatically harsh.",
      "Do not treat muted as automatically comfortable.",
      "Do not override physical constraints for feel preference.",
      "Do not recommend a string solely because marketing language describes it as premium feel."
