  "physical_override_logic": {
    "rule": {
      "en": "Feel preference never overrides physical safety constraints.",
      "zh": "任何手感偏好都不能覆盖身体安全与舒适性限制。"
    },

    "examples": [
      {
        "preference": "firm",
        "physical_constraint": "high_elbow_sensitivity",
        "result": "Do not recommend firm full-bed polyester."
      },

      {
        "preference": "crisp",
        "physical_constraint": "moderate_wrist_sensitivity",
        "result": "Use a softer crisp construction rather than high-tension firm polyester."
      }
    ]
  },

