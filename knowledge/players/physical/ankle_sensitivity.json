  "tension_adjustment": {
    "mild": {
      "adjustment_lbs": -1
    },

    "moderate": {
      "adjustment_lbs": -2
    },

    "high": {
      "adjustment_lbs": -3
    },

    "notes": [
      "Slightly lower tension can increase easy depth when movement limitations reduce ideal positioning.",
      "Do not lower tension excessively if directional control becomes unstable.",
      "String elasticity and racquet forgiveness are more important than tension alone."
    ]
  },

  "gauge_adjustment": {
    "preferred": [
      "1.20",
      "1.23",
      "1.25"
    ],

    "logic": {
      "need_more_easy_power": "Prefer thinner gauge when durability allows.",
      "need_more_control": "Prefer 1.25 before increasing tension aggressively."
    }
  },

  "movement_considerations": {
    "importance": "Critical",

    "affected_movements": [
      "Lateral acceleration",
      "Lateral deceleration",
      "Change of direction",
      "Wide defensive movement",
      "Recovery steps",
