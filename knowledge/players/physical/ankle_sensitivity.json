    "routing_rule": "This physical profile identifies equipment implications only. Exercise, rehabilitation and return-to-play recommendations should be handled by a separate recovery module."
  },

  "medical_warning": {
    "enabled": true,

    "message": {
      "en": "Equipment changes may reduce movement demands but cannot diagnose, treat or rehabilitate ankle injuries. Persistent instability, swelling, significant pain or recurrent sprains should be evaluated by a qualified healthcare professional.",
      "zh": "装备调整可以降低移动负担，但不能诊断、治疗或康复脚踝损伤。如持续存在不稳定、肿胀、明显疼痛或反复扭伤，应由专业医疗人员进行评估。"
    }
  },

