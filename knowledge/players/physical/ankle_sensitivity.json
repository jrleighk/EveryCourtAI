    "Ankle soreness after play",
    "Ankle stiffness",
    "Feeling of instability",
    "Reduced confidence during lateral movement",
    "Difficulty changing direction",
    "Discomfort during sudden stops",
    "Reduced confidence on wide defensive shots",
    "Fatigue during long movement sessions"
  ],

  "possible_contributors": [
    "Previous ankle sprain",
    "Repeated acceleration and deceleration",
    "Rapid lateral movement",
    "Frequent changes of direction",
    "Reduced ankle mobility",
    "Reduced lower-limb stability",
    "High training load",
    "Insufficient recovery"
  ],

