      "Stable off-center response",
      "Usable free power"
    ],

    "avoid": [
      "Very small sweet spot",
      "Extremely demanding control frames",
      "Very high swingweight",
      "Very heavy racquets",
      "Low-powered setups requiring perfect positioning"
