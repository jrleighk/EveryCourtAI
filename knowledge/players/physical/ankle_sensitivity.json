  "constraint": {
    "name": {
      "en": "Ankle Sensitivity",
      "zh": "脚踝敏感"
    },
    "description": {
      "en": "The player experiences ankle discomfort, stiffness, instability or reduced confidence during tennis movement. This profile is used to reduce unnecessary movement demands and improve equipment forgiveness.",
      "zh": "球员在网球移动过程中存在脚踝不适、僵硬、不稳定或移动信心下降。本画像用于降低不必要的移动负担，并提高装备容错性。"
    }
  },

  "priority": {
    "type": "Physical Constraint",
    "override_level": "Highest",
    "overrides": [
      "maximum_performance",
      "maximum_spin",
      "maximum_control",
      "maximum_stability_through_weight"
    ]
  },

  "severity_levels": {
    "none": {
      "score": 0
    },
