    "equipment_objectives": [
      "Increase forgiveness when positioning is imperfect",
      "Reduce need for maximal court coverage",
      "Provide easy depth from defensive positions",
      "Maintain maneuverability during late or compromised contact"
    ]
  },

  "positioning_compensation_logic": {
    "principle": {
      "en": "If ankle sensitivity reduces the player's ability to arrive in ideal hitting position, equipment should provide more forgiveness and easier depth rather than demand greater precision.",
      "zh": "如果脚踝敏感降低了球员到达理想击球位置的能力，装备应该提供更多容错与更轻松的深度，而不是进一步提高击球精准要求。"
    },

    "prioritize": [
      "Forgiveness",
      "Large Effective Sweet Spot",
      "Easy Power",
      "Stable Off-Center Response"
    ],

    "deprioritize": [
      "Small Head Size",
      "Very Low-Power Player Frames",
      "Extremely Demanding Stringbeds"
    ]
  },

