  "severity_logic": {
    "mild": {
      "recommendation": [
        "Maintain manageable swingweight",
        "Increase forgiveness",
        "Use comfortable string setup"
      ]
    },

    "moderate": {
      "recommendation": [
        "Prioritize larger sweet spot",
        "Increase easy power",
        "Reduce equipment demand",
        "Use softer string setup"
      ]
    },

    "high": {
      "recommendation": [
        "Use highly forgiving racquet",
        "Prioritize easy depth",
        "Use manageable swingweight",
        "Use comfort-oriented stringbed",
        "Avoid equipment requiring perfect footwork"
      ],

      "hard_constraints": [
        "Do not recommend very small unforgiving frames.",
        "Do not recommend excessive swingweight solely for stability.",
        "Do not recommend low-powered setups that require perfect court positioning.",
        "Do not allow performance goals to override significant movement limitations."
      ]
    }
  },

  "goal_conflict_logic": {
    "more_control": {
      "resolution": [
        "Increase predictability through string selection before reducing forgiveness.",
        "Do not automatically move to a smaller head size."
      ]
    },

    "more_spin": {
      "resolution": [
        "Generate spin through string geometry and racquet-head acceleration rather than demanding more court movement."
      ]
    },

    "more_power": {
      "resolution": [
        "Use efficient racquet power and elastic strings before increasing racquet mass."
      ]
    },

    "more_stability": {
      "resolution": [
        "Increase off-center stability without excessive swingweight."
      ]
    }
  },

  "ai_override_rules": {
    "if_ankle_sensitivity_is_high": {
      "override": true,

      "prioritize": [
        "Forgiveness",
        "Maneuverability",
        "Easy Power",
        "Large Effective Sweet Spot",
        "Reduced Movement Dependency"
      ],

      "deprioritize": [
        "Maximum Precision Through Small Head Size",
        "Maximum Swingweight",
        "Very Demanding Player Frames",
        "Low-Powered Setups Requiring Perfect Positioning"
      ]
    }
  },

