  "ai_override_rules": {
    "if_knee_sensitivity_is_high": {
      "override": true,

      "prioritize": [
        "Forgiveness",
        "Easy Power",
        "Comfort",
        "Maneuverability"
      ],

      "deprioritize": [
        "Maximum Precision",
        "Maximum Swingweight",
        "Demanding Control Frames"
      ]
    }
  },

