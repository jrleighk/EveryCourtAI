  "severity_logic": {
    "mild": {
      "recommendation": [
        "Soft polyester",
        "Reduce tension",
        "Comfort hybrid"
      ]
    },

    "moderate": {
      "recommendation": [
        "Premium multifilament",
        "Natural gut hybrid",
        "Reduce tension",
        "Review racquet stiffness"
      ]
    },

    "high": {
      "recommendation": [
        "Natural gut",
        "Premium multifilament",
        "Flexible racquet",
