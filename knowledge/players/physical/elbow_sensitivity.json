  "constraint": {
    "name": {
      "en": "Elbow Sensitivity",
      "zh": "肘部敏感"
    },
    "description": {
      "en": "The player experiences discomfort, soreness or has a history of tennis elbow or similar elbow-related conditions. This physical constraint has higher priority than equipment performance goals.",
      "zh": "球员存在肘部不适、网球肘或相关病史。此身体限制条件优先级高于装备性能目标。"
    }
  },

  "priority": {
    "type": "Physical Constraint",
    "override_level": "Highest",
    "overrides": [
      "more_spin",
      "more_control",
      "more_power",
      "more_durability",
      "maximum_performance"
    ]
  },

  "severity_levels": {
    "none": {
      "score": 0
    },
    "mild": {
      "score": 1
    },
    "moderate": {
      "score": 2
    },
    "high": {
      "score": 3
    }
  },

