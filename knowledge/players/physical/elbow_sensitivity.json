  "ai_override_rules": {
    "if_elbow_sensitivity_is_high": {
      "override": true,

      "ignore_if_goal_is": [
        "Maximum Spin",
        "Maximum Control",
        "Maximum Durability"
      ],

      "prioritize": [
        "Comfort",
        "Shock Absorption",
        "Long-Term Health",
        "Recovery"
      ]
    }
  },

  "medical_warning": {
    "enabled": true,

    "message": {
      "en": "Equipment adjustments may reduce impact stress but cannot diagnose, treat or cure elbow injuries. Persistent pain should be evaluated by a qualified healthcare professional.",
      "zh": "装备调整可以降低击球冲击，但不能诊断、治疗或治愈肘部损伤。如疼痛持续，请咨询专业医疗人员。"
    }
  },

  "tradeoffs": {
    "comfort_priority_can_reduce": [
      "Maximum Spin",
      "Maximum Control",
      "Maximum Durability"
    ],

    "acceptable_tradeoff": "Protecting elbow health is more important than maximizing equipment performance."
  },

  "matching_weights": {
    "comfort": 0.28,
    "shock_absorption": 0.22,
    "string_stiffness": 0.15,
    "racquet_stiffness": 0.12,
    "tension": 0.08,
    "ball_pocketing": 0.05,
    "forgiveness": 0.04,
    "feel": 0.03,
    "control": 0.02,
    "spin": 0.01
