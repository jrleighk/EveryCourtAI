  "constraint": {
    "name": {
      "en": "Shoulder Sensitivity",
      "zh": "肩部敏感"
    },
    "description": {
      "en": "The player experiences shoulder pain, fatigue or reduced mobility during or after tennis. This physical constraint has higher priority than equipment performance goals.",
      "zh": "球员在打球过程中或结束后容易出现肩部疼痛、疲劳或活动受限。此身体限制条件优先级高于装备性能目标。"
    }
  },

  "priority": {
    "type": "Physical Constraint",
    "override_level": "Highest",
    "overrides": [
      "more_power",
      "more_spin",
      "more_control",
      "more_durability",
      "maximum_performance"
    ]
  },

  "severity_levels": {
    "none": {
      "score": 0
    },
    "mild": {
      "score": 1
    },
    "moderate": {
      "score": 2
    },
    "high": {
      "score": 3
    }
  },

  "symptoms": [
    "Shoulder soreness after serving",
    "Pain during overhead shots",
    "Fatigue after long hitting sessions",
    "Reduced serve speed due to discomfort",
    "Difficulty accelerating the racquet",
    "Pain during high forehand follow-through",
    "Shoulder tightness after play",
    "Loss of endurance in long matches"
  ],

  "possible_causes": [
    "Racquet is too heavy",
