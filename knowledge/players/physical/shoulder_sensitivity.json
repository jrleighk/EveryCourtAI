  "serve_load_logic": {
    "importance": "Critical",

    "reason": {
      "en": "The serve places the greatest mechanical load on the shoulder. Excessive racquet weight or swingweight significantly increases cumulative fatigue.",
      "zh": "发球是肩部负荷最高的击球动作。过大的静态重量或挥重会显著增加肩部累计疲劳。"
    },

    "prioritize": [
      "Easy acceleration",
      "Lower swingweight",
      "Comfortable impact",
      "Efficient energy return"
    ]
  },

  "fatigue_logic": {
    "importance": "Very High",

    "evaluate": [
      "Match duration",
      "Training frequency",
      "Late-match performance",
      "Serve volume",
      "Age"
    ],

    "preferred_solution": [
      "Reduce racquet demand before reducing performance expectations."
    ]
  },

  "severity_logic": {
    "mild": {
      "recommendation": [
        "Lower tension",
        "Soft polyester",
        "Review swingweight"
      ]
    },

    "moderate": {
      "recommendation": [
        "Hybrid setup",
        "Multifilament",
        "Reduce swingweight",
        "Head-light balance"
      ]
    },

    "high": {
      "recommendation": [
        "Natural Gut",
        "Premium Multifilament",
        "Comfort racquet",
        "Low-impact setup"
      ],

      "hard_constraints": [
        "Avoid excessively heavy racquets.",
        "Avoid high swingweight.",
        "Avoid firm polyester at high tension."
      ]
    }
  },

  "ai_override_rules": {
    "if_shoulder_sensitivity_is_high": {
      "override": true,

      "ignore_if_goal_is": [
        "Maximum Stability",
        "Maximum Plow Through",
        "Maximum Power Through Weight"
      ],

      "prioritize": [
        "Maneuverability",
        "Comfort",
        "Easy Acceleration",
        "Reduced Fatigue"
      ]
    }
  },

  "goal_conflict_logic": {
    "more_power": {
      "resolution": [
        "Increase power through string elasticity before increasing racquet weight."
      ]
    },

    "more_stability": {
      "resolution": [
        "Improve torsional stability rather than static weight whenever possible."
      ]
    },

    "more_spin": {
      "resolution": [
        "Increase spin through string selection instead of increasing swingweight."
      ]
    }
  },

  "medical_warning": {
    "enabled": true,

    "message": {
      "en": "Equipment adjustments may reduce shoulder load but cannot diagnose or treat shoulder injuries. Persistent shoulder pain should be evaluated by a qualified healthcare professional.",
      "zh": "装备调整可以降低肩部负荷，但不能诊断或治疗肩部损伤。如肩部疼痛持续，请咨询专业医疗人员。"
    }
  },

  "tradeoffs": {
    "lighter_racquet_can_reduce": [
      "Plow Through",
      "Maximum Stability"
    ],

    "lower_swingweight_can_reduce": [
      "Ball Heaviness",
      "Mass Behind The Ball"
    ],

    "acceptable_tradeoff": "Protecting long-term shoulder health is more important than maximizing racquet mass."
  },

