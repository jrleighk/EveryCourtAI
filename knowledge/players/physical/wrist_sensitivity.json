  "tension_adjustment": {
    "mild": {
      "adjustment_lbs": -2
    },

    "moderate": {
      "adjustment_lbs": -3
    },

    "high": {
      "adjustment_lbs": -4
    },

    "notes": [
      "Reduce tension progressively.",
      "Changing to a softer string is generally more effective than tension reduction alone.",
      "Avoid combining firm polyester with high tension."
    ]
  },

  "gauge_adjustment": {
    "preferred": [
      "1.20",
      "1.23",
      "1.25"
    ],

    "avoid": [
      "Very thick firm polyester",
      "1.30 mm firm polyester unless durability requirements clearly justify it"
    ],

    "note": "Thinner gauges can improve elasticity and feel, but excessive string movement should be considered."
  },

  "racquet_adjustment": {
    "prefer": [
      "Moderate static weight",
      "Moderate swingweight",
      "Head-light or slightly head-light balance",
      "High torsional stability",
      "Large effective sweet spot",
      "Comfort-oriented frame response"
    ],

    "avoid": [
      "Very high swingweight",
      "Very head-heavy balance",
      "Low torsional stability",
      "Very stiff frames",
      "Demanding small-sweet-spot frames"
    ]
  },

  "maneuverability_logic": {
    "importance": "Very High",

    "reason": {
      "en": "Excessive swingweight or head-heavy balance can increase wrist load during acceleration, late contact and rapid directional changes.",
      "zh": "过高挥重或明显头重平衡会在加速、晚点击球以及快速改变拍头方向时增加手腕负担。"
    },

    "prioritize": [
      "Easy racquet-head acceleration",
      "Head-light balance",
      "Manageable swingweight"
    ]
  },

  "stability_logic": {
    "importance": "Very High",

    "reason": {
      "en": "A racquet that twists significantly on off-center contact can transfer additional torsional load to the wrist.",
      "zh": "球拍在偏心击球时如果明显扭转，会向手腕传递更多扭矩负荷。"
    },

    "prioritize": [
      "Stable off-center response",
      "Adequate twistweight",
      "Large effective sweet spot"
    ],

    "warning": "Do not increase stability through excessive swingweight if maneuverability becomes unsuitable."
  },

  "severity_logic": {
    "mild": {
      "recommendation": [
        "Soft polyester",
        "Reduce tension",
        "Review racquet balance",
        "Improve stringbed comfort"
      ]
    },

    "moderate": {
      "recommendation": [
        "Multifilament",
        "Natural gut hybrid",
        "Reduce tension",
        "Review swingweight",
        "Review frame stability"
      ]
    },

    "high": {
      "recommendation": [
        "Natural gut",
        "Premium multifilament",
        "Low-impact stringbed",
        "Maneuverable stable racquet"
      ],

      "hard_constraints": [
        "Avoid firm full-bed polyester.",
        "Avoid high polyester tension.",
        "Avoid excessive swingweight.",
        "Avoid strongly head-heavy racquets."
      ]
    }
  },

  "ai_override_rules": {
    "if_wrist_sensitivity_is_high": {
      "override": true,

      "ignore_if_goal_is": [
        "Maximum Spin",
        "Maximum Control",
        "Maximum Durability",
        "Maximum Stability Through Weight"
      ],

      "prioritize": [
        "Comfort",
        "Maneuverability",
        "Torsional Stability",
        "Shock Absorption",
        "Predictable Contact"
      ]
    }
  },

  "goal_conflict_logic": {
    "more_spin": {
      "resolution": [
        "Prefer soft shaped polyester only when sensitivity is mild.",
        "Prefer lower-friction hybrids over very firm spin polyester.",
        "Do not chase spin through excessive wrist load."
      ]
    },

    "more_stability": {
      "resolution": [
        "Increase torsional stability without creating excessive swingweight.",
        "Do not automatically recommend heavier racquets."
      ]
    },

    "more_control": {
      "resolution": [
        "Use predictable string construction before significantly increasing tension."
      ]
    },

    "more_durability": {
      "resolution": [
        "Select a durable soft construction before moving to very thick firm polyester."
      ]
    }
  },

  "medical_warning": {
    "enabled": true,

    "message": {
      "en": "Equipment adjustments may reduce impact and torsional stress but cannot diagnose or treat wrist injuries. Persistent, worsening or significant wrist pain should be evaluated by a qualified healthcare professional.",
      "zh": "装备调整可能降低冲击与扭矩负荷，但不能诊断或治疗手腕损伤。如果手腕疼痛持续、加重或较明显，应咨询专业医疗人员。"
    }
  },

  "tradeoffs": {
    "comfort_priority_can_reduce": [
      "Maximum Spin",
      "Maximum Firm Control",
      "Maximum Durability"
    ],

    "maneuverability_priority_can_reduce": [
      "Maximum Plow Through",
      "Maximum Swingweight Stability"
    ],

    "acceptable_tradeoff": "Reducing wrist load is more important than maximizing a single performance characteristic."
  },

