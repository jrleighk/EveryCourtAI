{
  "id": "wrist_sensitivity",
  "category": "Player Physical Constraint",
  "version": "1.0",
  "last_updated": "2026-08-15",

  "constraint": {
    "name": {
      "en": "Wrist Sensitivity",
      "zh": "手腕敏感"
    },
    "description": {
      "en": "The player experiences wrist discomfort, soreness, fatigue or sensitivity during or after play. This physical constraint has higher priority than performance-oriented equipment goals.",
      "zh": "球员在击球过程中或击球后存在手腕不适、酸痛、疲劳或敏感。此身体限制条件优先级高于性能导向的装备目标。"
    }
  },

  "priority": {
    "type": "Physical Constraint",
    "override_level": "Highest",
    "overrides": [
      "more_spin",
      "more_control",
      "more_power",
      "more_durability",
      "maximum_performance"
    ]
  },

  "severity_levels": {
    "none": {
      "score": 0
    },
    "mild": {
      "score": 1
    },
    "moderate": {
      "score": 2
    },
    "high": {
      "score": 3
    }
  },

  "symptoms": [
    "Wrist soreness after play",
    "Pain during impact",
    "Pain during topspin generation",
    "Discomfort during serve",
    "Discomfort during late contact",
    "Fatigue when accelerating the racquet",
    "Pain on off-center hits",
    "Reduced confidence during aggressive swings"
  ],

  "possible_causes": [
    "Very stiff stringbed",
    "Firm polyester",
    "High string tension",
    "Very high swingweight",
    "Head-heavy balance",
    "Frame instability on off-center contact",
    "Late contact point",
    "Excessive wrist-dominant stroke mechanics",
    "Dead polyester",
    "Overuse"
  ],

  "equipment_strategy": {
    "primary_goal": "Reduce Wrist Impact Load And Torsional Stress",

    "change_priority": [
      "String Material",
      "String Tension",
      "Racquet Maneuverability",
      "Racquet Stability",
      "Hybrid Architecture",
      "Gauge",
      "Racquet"
    ]
  },

  "recommended_string_families": [
    "Natural Gut",
    "Premium Multifilament",
    "Soft Multifilament",
    "Soft Co-Polyester",
    "Natural Gut / Polyester Hybrid",
    "Multifilament / Soft Polyester Hybrid"
  ],

  "avoid_string_families": [
    "Very Firm Polyester",
    "Dead Polyester",
    "High-Stiffness Polyester",
    "Very Thick Firm Polyester"
  ],

