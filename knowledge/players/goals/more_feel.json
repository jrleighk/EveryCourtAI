  "goal": {
    "name": {
      "en": "More Feel",
      "zh": "提升手感"
    },

    "description": {
      "en": "The player wants greater connection with the ball, clearer impact feedback, improved touch, precision and confidence during every shot.",
      "zh": "球员希望获得更清晰的击球反馈、更好的控球感、更多包球感，以及更精准的落点控制与触球信心。"
    }
  },

  "problem_signs": [
    "Current stringbed feels numb.",
    "Player cannot clearly feel ball contact.",
    "Drop shots are difficult to judge.",
    "Volleys lack touch.",
    "Ball leaves the strings too quickly.",
    "Player struggles to judge depth consistently.",
    "Current setup feels disconnected."
  ],

  "typical_causes": [
    "Current string is too stiff.",
    "Current string has poor ball pocketing.",
    "Current racquet is too muted.",
    "Current tension is excessively high.",
    "Current polyester has gone dead.",
    "Impact dwell time is too short.",
    "Current setup prioritizes durability over feel."
  ],

