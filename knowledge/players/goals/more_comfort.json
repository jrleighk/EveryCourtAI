{
  "id": "more_comfort",
  "category": "Player Goal",
  "version": "1.0",
  "last_updated": "2026-08-15",

  "goal": {
    "name": {
      "en": "More Comfort",
      "zh": "提升舒适性"
    },

    "description": {
      "en": "The player wants a softer, less harsh and more forgiving impact response with reduced shock and improved ball pocketing, without unnecessarily sacrificing control or playability.",
      "zh": "球员希望获得更柔和、更少冲击、更宽容的击球反馈，并提升减震与包球感，同时尽量避免不必要地牺牲控制与整体可打性。"
    }
  },

  "problem_signs": [
    "Stringbed feels harsh or board-like.",
    "Arm or forearm feels fatigued after play.",
    "Off-center hits feel uncomfortable.",
    "Player dislikes sharp impact feedback.",
    "Current polyester setup feels too stiff.",
    "Player wants longer dwell time and more pocketing.",
    "Comfort decreases noticeably late in long sessions."
  ],

  "typical_causes": [
    "String is too stiff.",
    "String tension is too high.",
    "Racquet stiffness is high.",
    "Full polyester setup is too demanding.",
    "String has gone dead and lost elasticity.",
    "Gauge is unnecessarily thick.",
    "Racquet swingweight or static weight increases physical fatigue.",
    "Current setup combines multiple stiff variables at the same time."
  ],

  "equipment_adjustments": {
    "racquet": {
      "preferred_changes": [
        "More flexible frame",
        "Better vibration management",
        "More forgiving sweet spot",
        "Lower physical demand",
        "More manageable swingweight"
      ],

      "change_priority": "low_to_medium",

      "note": "String type and tension should normally be adjusted before recommending a racquet change unless the frame itself is clearly contributing to discomfort."
    },

    "string": {
      "preferred_changes": [
        "Multifilament",
        "Natural Gut",
        "Soft Co-Polyester",
        "Elastic Polymer",
        "Comfort-Oriented Hybrid",
        "More Flexible String Construction"
      ]
    },

    "tension": {
      "general_adjustment_lbs": -2,

      "normal_adjustment_range_lbs": "-1 to -4",

      "notes": [
        "Reduce tension progressively rather than making a very large change immediately.",
        "For firm polyester, changing to a softer construction is often more effective than tension reduction alone.",
        "Do not lower tension so far that launch and directional control become unstable."
      ]
    },

    "gauge": {
      "preferred_direction": "Slightly Thinner When Durability Allows",

      "examples": [
        "1.30 to 1.25 mm",
        "1.25 to 1.20 mm"
      ],

      "tradeoff": "Thinner gauges may increase comfort and elasticity but can reduce durability and stringbed stability."
    }
  },

  "recommended_string_families": [
    "Multifilament",
    "Natural Gut",
    "Soft Co-Polyester",
