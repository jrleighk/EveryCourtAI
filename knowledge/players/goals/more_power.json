  "goal": {
    "name": {
      "en": "More Power",
      "zh": "提升力量"
    },

    "description": {
      "en": "The player wants easier depth, higher ball speed and more usable pace without needing to swing significantly harder.",
      "zh": "球员希望在不明显增加挥拍负担的情况下获得更轻松的击球深度、更高球速和更多可用力量。"
    }
  },

  "problem_signs": [
    "Balls frequently land short.",
    "Player needs to over-swing to reach depth.",
    "Serve lacks penetration.",
    "Defensive shots do not reach sufficient depth.",
    "Player feels the current setup is dead or underpowered.",
    "Performance drops significantly late in matches due to effort."
  ],

  "typical_causes": [
    "Racquet is too low-powered for the player's swing speed.",
    "String is too firm or too low-powered.",
    "String tension is too high.",
    "Gauge is too thick.",
    "Dense string pattern reduces easy launch.",
    "String has lost elasticity.",
    "Player has slow-to-medium swing speed.",
    "Current racquet swingweight or static weight reduces acceleration."
  ],

