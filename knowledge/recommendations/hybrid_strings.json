  "hybrid_principles": {
    "main_string_priority": [
      "The main string contributes most strongly to the overall feel, spin behavior, power and response of the stringbed.",
      "主线通常对整体手感、旋转、力量以及线床响应产生更大的影响。"
    ],

    "cross_string_priority": [
      "The cross string is used to tune comfort, snapback, control, durability and launch behavior.",
      "横线主要用于调整舒适度、Snapback、控制、耐久以及出球轨迹。"
    ],

    "general_rules": [
      "Natural Gut mains + Polyester crosses prioritizes power, feel, comfort and controlled spin.",
      "Polyester mains + Multifilament or Natural Gut crosses prioritizes spin, control and durability while softening the stringbed.",
      "Shaped Polyester mains + Smooth Round Polyester crosses prioritizes mechanical bite plus snapback.",
      "Soft Polyester mains + Soft cross strings are preferred when comfort is more important than maximum durability."
    ]
  },

